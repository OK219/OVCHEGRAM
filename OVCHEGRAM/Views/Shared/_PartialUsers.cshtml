@using System.Security.Claims
@model IEnumerable<UserPartialDto>

@foreach (var user in Model)
{
    <a class="userLink" asp-controller="Profile" asp-action="Profile" asp-route-id="@user.Id">
        <div class="user">
            <img class="profilePic" src="@user.FilePath" alt="@user.Id profilePic">
            <p>@user.FirstName @user.SecondName</p>
            <form asp-controller="Chat" asp-action="RedirectToPersonalConversation" asp-route-id1="@user.Id">
                <button type="submit">написать</button>
            </form>
        </div>
    </a>
}
