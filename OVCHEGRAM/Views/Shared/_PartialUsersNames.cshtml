@using System.Security.Claims
@model IEnumerable<UserPartialDto>

@foreach (var item in Model)
{
    <div class="user">
        <img class="profilePic" src="@item.FilePath" alt="@item.Id profilePic">
        <p class="userName">@item.FirstName @item.SecondName</p>
        <p class="userId">@item.Id</p>
    </div>
}
